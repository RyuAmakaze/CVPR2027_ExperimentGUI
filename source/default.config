<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 相対パスは、このConfigと実行ファイルのあるフォルダを基準にします。変更後はGUIを再起動してください。 -->
    <add key="DataFolder" value=".\experiment_data" />
    <add key="ResultsFolder" value=".\results" />
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" /></startup>
  <runtime><AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" /></runtime>
</configuration>
